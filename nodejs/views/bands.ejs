<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>Lista zespołów</title>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #f9f9f9;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: #333;
    }

    table {
      width: 90%;
      margin: 20px auto;
      border-collapse: collapse;
      background-color: #fff;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    th, td {
      padding: 12px 20px;
      border-bottom: 1px solid #ddd;
      text-align: left;
      word-break: break-word;
    }

    th {
      background-color: #4CAF50;
      color: white;
    }

    img {
      max-width: 100px;
      max-height: 100px;
      border-radius: 6px;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .center {
      text-align: center;
      margin-top: 30px;
      color: #777;
    }

    .links {
      text-align: center;
      margin: 20px 0;
    }

    .links a {
      margin: 0 10px;
      padding: 8px 15px;
      text-decoration: none;
      color: #fff;
      background-color: #4CAF50;
      border-radius: 4px;
      transition: background-color 0.3s ease;
    }
    .links a:hover {
      background-color: #45a049;
      text-decoration: none;
    }

    .actions {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    .actions form {
      display: inline;
    }

    .btn {
      padding: 4px 8px;
      border: none;
      border-radius: 3px;
      cursor: pointer;
      text-decoration: none;
      font-size: 12px;
      color: white;
      transition: background-color 0.3s ease;
    }

    .btn-edit {
      background-color: #2196F3;
    }

    .btn-edit:hover {
      background-color: #1976D2;
    }

    .btn-delete {
      background-color: #f44336;
    }

    .btn-delete:hover {
      background-color: #d32f2f;
    }
  </style>
</head>
<body>
  <h1>Zespoły zarejestrowane w GigMap</h1>
  <div class="links">
    <a href="<%= basePath %>/bands/new">Dodaj zespół</a> | <a href="<%= basePath %>/">Strona główna</a>
  </div>

  <% if (bands.length === 0) { %>
    <p class="center">Brak zespołów w bazie.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Nazwa</th>
          <th>Gatunek</th>
          <th>Opis</th>
          <th>Email</th>
          <th>Telefon</th>
          <th>WWW</th>
          <th>Obrazek</th>
          <th>Dostępność</th>
          <th>Akcje</th>
        </tr>
      </thead>
      <tbody>
        <% bands.forEach(band => { %>
          <tr>
            <td><%= band.name %></td>
            <td><%= band.genre %></td>
            <td><%= band.description || 'Brak' %></td>
            <td><%= band.contactEmail || 'Brak' %></td>
            <td><%= band.contactPhone || 'Brak' %></td>
            <td>
              <% if (band.websiteUrl) { %>
                <a href="<%= band.websiteUrl %>" target="_blank">Link</a>
              <% } else { %>
                Brak
              <% } %>
            </td>
            <td>
              <% if (band.image) { %>
                <img src="<%= basePath %>/<%= band.image %>" alt="<%= band.name %>" />
              <% } else { %>
                Brak
              <% } %>
            </td>
            <td>
              <% if (band.availability && band.availability.length > 0) { %>
                <ul>
                  <% band.availability.forEach(slot => { %>
                    <li><%= new Date(slot.start).toLocaleString('pl-PL') %> - <%= new Date(slot.end).toLocaleString('pl-PL') %></li>
                  <% }) %>
                </ul>
              <% } else { %>
                Brak informacji
              <% } %>
            </td>
            <td class="actions">
              <a href="<%= basePath %>/bands/edit/<%= band._id %>" class="btn btn-edit">Edytuj</a>
              <form action="<%= basePath %>/bands/delete" method="POST" style="display: inline;" onsubmit="return confirm('Czy na pewno chcesz usunąć ten zespół?')">
                <input type="hidden" name="_method" value="DELETE">
                <input type="hidden" name="id" value="<%= band._id %>">
                <button type="submit" class="btn btn-delete">Usuń</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
